{
  "name": "screenshare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "electron": "^44.9.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@material-symbols/font-400": "^0.48.0",
    "preact": "^11.0.1",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.22.0"
  },
  "scripts": {
    "server": "node --watch server/main.ts",
    "typecheck": "tsc -p . && tsc -p client && tsc -p client/tsconfig.test.json && tsc -p desktop",
    "dev": "vite client",
    "build": "vite build client",
    "start": "node scripts/dev.ts",
    "desktop": "node scripts/build-desktop.ts && env -u ELECTRON_RUN_AS_NODE electron dist/desktop/main.mjs",
    "e2e": "node scripts/e2e/run.ts",
    "test": "node --test 'server/**/*.test.ts' 'client/src/**/*.test.ts'"
  }
}
